# Copy to docker/.env (`make bootstrap` does this for you).
# These credentials are for a local learning environment only.

PG_MAJOR=17

POSTGRES_DB=polaris
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris_dev_only
