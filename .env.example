# Copy to .env (`make bootstrap` does this for you).
# Read by scripts/ and benchmarks/ when connecting from the host.

PGHOST=localhost
PGPORT=5432
PGDATABASE=polaris
PGUSER=polaris
PGPASSWORD=polaris_dev_only

# Container used by scripts that exec into the database.
POLARIS_CONTAINER=polaris-db

# Synthetic data generator (sql/03_dml_queries/seed_data.sql reads these
# through psql variables; the values below reproduce the published results).
POLARIS_SCALE=1
POLARIS_SEED=0.42
